{
  "name": "hanzi-practice",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@freeappstore/sdk@0.16.0": "patches/@freeappstore__sdk@0.16.0.patch",
      "hanzi-writer@3.7.3": "patches/hanzi-writer@3.7.3.patch"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/hanzi-practice.git"
  },
  "scripts": {
    "dev": "pnpm --filter @hanzi-practice/web dev",
    "build": "pnpm --filter @hanzi-practice/web build",
    "preview": "pnpm --filter @hanzi-practice/web preview",
    "typecheck": "pnpm --filter @hanzi-practice/web exec tsc -b",
    "test": "pnpm build && node --import tsx --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "prepare:data": "tsx scripts/prepare-characters.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "hanzi-writer-data": "^2.0.1",
    "tsx": "^4.23.15"
  }
}
